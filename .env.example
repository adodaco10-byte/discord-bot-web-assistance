# Discord bot and web assistant configuration

# Required
DISCORD_TOKEN=your_discord_bot_token_here
BOT_NAME=AssistBot
COMMAND_PREFIX=!
WEB_HOST=0.0.0.0
WEB_PORT=5000
SECRET_KEY=change_this_secret_key
WEB_ASSISTANT_ENABLED=true
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Optional: leave empty if not using OpenAI-compatible API
OPENAI_API_KEY=
