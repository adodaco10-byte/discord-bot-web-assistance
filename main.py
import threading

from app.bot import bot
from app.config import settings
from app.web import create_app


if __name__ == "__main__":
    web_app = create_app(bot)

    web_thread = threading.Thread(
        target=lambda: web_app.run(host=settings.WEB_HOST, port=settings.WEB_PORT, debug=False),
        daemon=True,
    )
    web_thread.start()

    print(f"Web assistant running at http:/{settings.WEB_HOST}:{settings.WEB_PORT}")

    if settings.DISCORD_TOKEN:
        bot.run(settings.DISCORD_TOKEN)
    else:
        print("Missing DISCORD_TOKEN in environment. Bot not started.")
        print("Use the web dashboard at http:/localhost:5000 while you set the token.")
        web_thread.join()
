import asyncio
import discord
from discord.ext import commands

from app.assistant import generate_response
from app.config import settings


class BotClient(commands.Bot):
    def __init__(self):
        intents = discord.Intents.default()
        intents.message_content = True
        intents.members = True

        super().__init__(
            command_prefix=settings.COMMAND_PREFIX,
            help_command=None,
            intents=intents,
        )

    async def on_ready(self):
        print(f"Logged in as {self.user} (ID: {self.user.id})")
        try:
            synced = await self.tree.sync()
            print(f"Synced {len(synced)} slash commands")
        except Exception as exc:  # pragma: no cover
            print(f"Could not sync slash commands: {exc}")

        if settings.DISCORD_CHANNEL_ID:
            channel = self.get_channel(int(settings.DISCORD_CHANNEL_ID))
            if channel:
                await channel.send(f"{settings.BOT_NAME} is online and ready.")

    async def on_message(self, message):
        if message.author.bot:
            return

        if message.content.startswith(settings.COMMAND_PREFIX):
            await self.process_commands(message)
            return

        if self.user.mentioned_in(message):
            prompt = message.content.replace(f"<@{self.user.id}>", "").strip()
            if not prompt:
                await message.channel.send("Hello! Ask me anything.")
                return

            response = generate_response(prompt)
            await message.channel.send(response)

    @commands.command(name="help")
    async def help_command(self, ctx):
        embed = discord.Embed(
            title=f"{settings.BOT_NAME} help",
            description="Commands available in this Discord bot.",
            color=discord.Color.blurple(),
        )
        embed.add_field(name="!help", value="Show help information.", inline=False)
        embed.add_field(name="!ping", value="Check the bot response time.", inline=False)
        embed.add_field(name="!status", value="Display bot health status.", inline=False)
        embed.add_field(name="!say <text>", value="Repeat a message in the channel.", inline=False)
        embed.add_field(name="!ask <question>", value="Ask the assistant a question.", inline=False)
        await ctx.send(embed=embed)

    @commands.command(name="ping")
    async def ping_command(self, ctx):
        await ctx.send(f"Pong! Latency: {round(self.latency * 1000)}ms")

    @commands.command(name="status")
    async def status_command(self, ctx):
        await ctx.send("System online. Discord bot and web assistant are available.")

    @commands.command(name="say")
    async def say_command(self, ctx, *, text: str):
        await ctx.send(text)

    @commands.command(name="ask")
    async def ask_command(self, ctx, *, question: str):
        response = generate_response(question)
        await ctx.send(response)

    @discord.app_commands.command(name="ping")
    async def slash_ping(self, interaction: discord.Interaction):
        await interaction.response.send_message(f"Pong! Latency: {round(self.latency * 1000)}ms")

    @discord.app_commands.command(name="ask")
    async def slash_ask(self, interaction: discord.Interaction, question: str):
        response = generate_response(question)
        await interaction.response.send_message(response)


bot = BotClient()


async def send_notification(message: str, channel_id: str | None = None):
    if not channel_id:
        channel_id = settings.DISCORD_CHANNEL_ID

    if not channel_id:
        return

    channel = bot.get_channel(int(channel_id))
    if channel:
        await channel.send(message)
